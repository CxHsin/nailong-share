---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Avatar from '../../components/Avatar.astro';
import SideToc from '../../components/SideToc.astro';
import { authors } from '../../data/authors';
export async function getStaticPaths() { return (await getCollection('notes')).map(note => ({ params: { id: note.id }, props: { note } })); }
const { note } = Astro.props;
const { Content, headings } = await render(note);
const author = authors[note.data.author];
---
<Layout title={note.data.title} description={note.data.description} pdf={note.data.pdf}>
  <main id="main" class="reading-layout">
    <article class="reading-article" data-pagefind-body>
      <header class="article-header article-column">
        <div class="article-tags" data-pagefind-ignore>{note.data.tags.map(tag => <span>{tag}<Icon name="plus" /></span>)}</div>
        <h1 data-pagefind-meta="title">{note.data.title}</h1>
        <p class="article-description" data-pagefind-ignore>{note.data.description}</p>
        <div class="article-byline" data-pagefind-ignore>
          <a class="byline-author" href={author?.url ?? note.data.source} target="_blank" rel="noreferrer"><Avatar name={note.data.author} src={author?.avatar} /><span>{note.data.author}</span></a>
          <time datetime={note.data.date}>{note.data.date.replaceAll('-', '.')}</time>
        </div>
      </header>
      <figure class="article-cover" data-pagefind-ignore><img src={note.data.cover} alt={note.data.title + '的视频封面'} width="960" height="540" fetchpriority="high" /></figure>
      <div class="prose article-column"><Content /></div>
      <footer class="article-end article-column" data-pagefind-ignore>
        <div class="article-tags">{note.data.tags.map(tag => <span>{tag}</span>)}</div>
        <div class="article-toolbar"><a class="text-link" href={note.data.pdf} download>保存 PDF <Icon name="download" /></a></div>
        <div class="end-author"><Avatar name={note.data.author} src={author?.avatar} class="avatar-large" /><h2>{note.data.author}</h2><p>本文根据原视频整理，完整笔记与原始 PDF 均可阅读。</p><a class="source-pill" href="/">阅读其他笔记</a></div>
      </footer>
    </article>
  </main>
  <SideToc headings={headings} />
</Layout>
