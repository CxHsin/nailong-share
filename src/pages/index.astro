---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const notes = (await getCollection('notes')).sort((a,b) => b.data.date.localeCompare(a.data.date));
const tags = [...new Set(notes.flatMap(n => n.data.tags))];
---
<Layout>
  <main id="main" class="home-main">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="eyebrow"><span class="small-star" aria-hidden="true">✳</span> A PERSONAL COLLECTION</div>
      <h1 id="home-title">有些内容，<br />值得<span class="title-em">再读一遍。</span></h1>
      <p>从视频里拾起想法，整理成可以慢慢读的文字。<br class="desktop-break" />关于技术、生活，以及一切让人好奇的事。</p>
      <div class="intro-mark" aria-hidden="true"><svg viewBox="0 0 160 180" fill="none"><path d="M80 4C76 66 60 82 6 90c54 8 70 24 74 86 4-62 20-78 74-86C100 82 84 66 80 4Z" stroke="currentColor"/><path d="M80 30C77 71 67 83 30 90c37 7 47 19 50 60 3-41 13-53 50-60C93 83 83 71 80 30Z" stroke="currentColor"/><circle cx="80" cy="90" r="61" stroke="currentColor" stroke-dasharray="2 6"/></svg></div>
    </section>
    <section class="library" aria-labelledby="collection-title">
      <div class="collection-heading"><h2 id="collection-title">所有内容 <span>{String(notes.length).padStart(2, '0')}</span></h2><span class="collection-order">按最近整理排序 ↓</span></div>
      <div class="library-tools">
        <div class="tag-filters" role="group" aria-label="按标签筛选">
          <button class="filter active" data-tag="" aria-pressed="true">全部</button>
          {tags.map(tag => <button class="filter" data-tag={tag} aria-pressed="false">{tag}</button>)}
        </div>
        <form class="search-form" role="search"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><label class="sr-only" for="search">搜索标题和正文</label><input id="search" type="search" placeholder="搜索内容…" autocomplete="off" /><kbd aria-hidden="true">/</kbd></form>
      </div>
      <p id="search-status" class="search-status" aria-live="polite"></p>
      <div id="search-results" class="search-results" hidden></div>
      <div class="card-grid" id="card-grid">
        {notes.map((note, index) => <a class="note-card" href={`/read/${note.id}/`} data-tags={JSON.stringify(note.data.tags)}>
          <div class="card-image"><img src={note.data.cover} alt={note.data.title + '的视频封面'} loading={index > 1 ? 'lazy' : 'eager'} width="960" height="540" /><span class="card-index">NO. {String(notes.length-index).padStart(2,'0')}</span><span class="card-open" aria-hidden="true">↗</span></div>
          <div class="card-meta"><time datetime={note.data.date}>{note.data.date.replaceAll('-', ' / ')}</time><span>{note.data.tags.slice(0,2).join(' · ')}</span></div>
          <h3>{note.data.title}</h3><p>{note.data.description}</p>
          <div class="card-bottom"><span>{note.data.author}</span><span class="read-link">开始阅读 <span aria-hidden="true">↗</span></span></div>
        </a>)}
      </div>
      <p class="collection-tail">收藏还在慢慢生长。<span aria-hidden="true">✳</span></p>
    </section>
  </main>
  <script>
    type Result = { url: string; excerpt: string; meta: { title: string }; sub_results?: { url: string; title: string; excerpt: string }[] };
    type Pagefind = { search: (query: string) => Promise<{ results: { data: () => Promise<Result> }[] }> };
    const input = document.querySelector<HTMLInputElement>('#search')!;
    const grid = document.querySelector<HTMLElement>('#card-grid')!;
    const results = document.querySelector<HTMLElement>('#search-results')!;
    const status = document.querySelector<HTMLElement>('#search-status')!;
    const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    let selectedTag = '', sequence = 0, timer: ReturnType<typeof setTimeout>;
    let pagefind: Pagefind;
    const cards = [...grid.querySelectorAll<HTMLElement>('.note-card')];
    function filterCards() { cards.forEach(card => { card.hidden = !!selectedTag && !JSON.parse(card.dataset.tags!).includes(selectedTag); }); }
    function appendText(parent: HTMLElement, text: string) {
      // Pagefind excerpts contain <mark>; construct only those nodes rather than injecting HTML.
      const parsed = new DOMParser().parseFromString(text, 'text/html');
      for (const node of parsed.body.childNodes) {
        if (node instanceof HTMLElement && node.tagName === 'MARK') { const mark = document.createElement('mark'); mark.textContent = node.textContent; parent.append(mark); }
        else parent.append(document.createTextNode(node.textContent || ''));
      }
    }
    async function search() {
      const current = ++sequence, query = input.value.trim();
      if (!query) { grid.hidden = false; results.hidden = true; status.textContent = ''; filters.forEach(b => b.disabled = false); filterCards(); return; }
      grid.hidden = true; results.hidden = false; results.replaceChildren();
      filters.forEach(b => b.disabled = true);
      status.textContent = '正在查找…';
      try {
        const searchModule = '/pagefind/pagefind.js';
        pagefind ??= await import(/* @vite-ignore */ searchModule);
        const found = await pagefind.search(query);
        const entries = await Promise.all(found.results.slice(0,20).map(r => r.data()));
        if (current !== sequence) return;
        status.textContent = entries.length ? `找到 ${found.results.length} 篇相关内容` : '没有找到相关内容，试试其他关键词。';
        entries.forEach(entry => {
          const container = document.createElement('article'); container.className = 'search-result';
          const title = document.createElement('a'); title.href = entry.url; title.textContent = entry.meta.title; title.className = 'result-title'; container.append(title);
          const sections = entry.sub_results?.length ? entry.sub_results.slice(0,3) : [{url:entry.url, title:'', excerpt:entry.excerpt}];
          sections.forEach(section => { const a = document.createElement('a'); a.href = section.url; a.className = 'result-section'; if(section.title && section.title !== entry.meta.title) { const h = document.createElement('strong'); h.textContent = section.title; a.append(h); } const p = document.createElement('p'); appendText(p, section.excerpt); a.append(p); container.append(a); });
          results.append(container);
        });
      } catch { if(current === sequence) status.textContent = import.meta.env.DEV ? '正文搜索在构建后可用：运行 npm run build，再运行 npm run preview。' : '搜索暂时不可用，请稍后重试。'; }
    }
    filters.forEach(button => button.addEventListener('click', () => { selectedTag = button.dataset.tag!; filters.forEach(b => { b.classList.toggle('active', b === button); b.setAttribute('aria-pressed', String(b === button)); }); filterCards(); }));
    input.addEventListener('input', () => { ++sequence; clearTimeout(timer); timer = setTimeout(search, 180); });
    document.querySelector('.search-form')!.addEventListener('submit', e => { e.preventDefault(); clearTimeout(timer); search(); });
    document.addEventListener('keydown', e => { const el = e.target as HTMLElement; if(e.key === '/' && !['INPUT','TEXTAREA'].includes(el.tagName) && !el.isContentEditable) { e.preventDefault(); input.focus(); } if(e.key === 'Escape' && document.activeElement === input) { input.value=''; search(); input.blur(); } });
  </script>
</Layout>
