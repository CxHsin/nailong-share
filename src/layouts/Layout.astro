---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; pdf?: string; home?: boolean; }
const { title = 'Nailong Share', description = '把值得重读的内容，留在这里。', pdf, home = false } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-theme="dark" data-page={home ? 'home' : pdf ? 'article' : 'other'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171717" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <title>{title === 'Nailong Share' ? 'Nailong Share · 留下值得重读的内容' : `${title} · Nailong Share`}</title>
    <script is:inline>
      let savedTheme;
      try { savedTheme = localStorage.getItem('theme'); } catch {}
      document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
      document.querySelector('meta[name="theme-color"]').content = savedTheme === 'light' ? '#ffffff' : '#171717';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href="/" aria-label="Nailong Share 首页">Nailong Share</a>
      <form class="search-form" role="search" action="/">
        <Icon name="search" />
        <label class="sr-only" for="search">搜索标题和正文</label>
        <input id="search" name="q" type="search" placeholder="搜索" autocomplete="off" />
      </form>
      <nav class="header-actions" aria-label="主导航">
        <a class="icon-button" href="https://github.com/CxHsin/nailong-share" target="_blank" rel="noopener noreferrer" aria-label="在新标签页打开 Nailong Share 的 GitHub 仓库" title="GitHub 仓库"><Icon name="github" /></a>
        <button class="theme-toggle icon-button" type="button" aria-label="切换至浅色模式" title="切换阅读配色"><Icon name="sun" /></button>
      </nav>
    </header>
    <slot />
    {!home && <footer class="site-footer" data-pagefind-ignore><a href="/">Nailong Share</a><span>留下值得重读的内容。</span></footer>}
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
      const searchInput = document.querySelector<HTMLInputElement>('#search')!;
      function syncTheme() {
        const dark = document.documentElement.dataset.theme === 'dark';
        toggle.setAttribute('aria-label', dark ? '切换至浅色模式' : '切换至深色模式');
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = dark ? '#171717' : '#ffffff';
      }
      syncTheme();
      toggle.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        syncTheme();
      });
      if (document.documentElement.dataset.page !== 'home') {
        document.addEventListener('keydown', e => {
          const el = e.target as HTMLElement;
          if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(el.tagName) && !el.isContentEditable) { e.preventDefault(); searchInput.focus(); }
          if (e.key === 'Escape' && document.activeElement === searchInput) { searchInput.value = ''; searchInput.blur(); }
        });
      }
    </script>
  </body>
</html>
