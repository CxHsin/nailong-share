---
interface Props { name: string; class?: string; src?: string; }
const { name, class: className, src } = Astro.props;
const initials = name.split(/[·（(]/)[0].trim().split(/\s+/).map(word => [...word][0]).slice(0, 2).join('').toUpperCase();
---
<span class:list={['avatar', className]} aria-hidden="true">{src ? <img src={src} alt="" width="200" height="200" /> : initials}</span>
