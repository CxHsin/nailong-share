---
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const sections = Astro.props.headings.filter(heading => heading.depth === 2);
---
{sections.length > 0 && <nav class="side-toc" aria-label="章节目录" tabindex="0" data-pagefind-ignore>
  <ol>
    {sections.map((section, index) => <li><a href={`#${section.slug}`} aria-current={index === 0 ? 'location' : undefined} title={section.text}><span>{section.text}</span></a></li>)}
  </ol>
</nav>}
<style>
  .side-toc { --toc-active: #fff; position: fixed; z-index: 10; left: calc(50% + 468px); top: calc(50% + 28px); transform: translateY(-50%); width: min(244px, calc(50% - 496px)); }
  :global(:root[data-theme='light']) .side-toc { --toc-active: var(--ink); }
  .side-toc:focus-visible { outline: 2px solid var(--accent); outline-offset: 8px; }
  ol { list-style: none; margin: 0; padding: 0; max-height: calc(100svh - 160px); overflow-y: auto; scrollbar-width: none; }
  ol::-webkit-scrollbar { display: none; }
  a { display: flex; align-items: center; position: relative; height: 12px; padding-left: 18px; color: var(--muted); font-size: 14px; line-height: 1.5; transition: height 280ms cubic-bezier(.2,.75,.25,1), color 280ms ease; }
  a::before { content: ''; position: absolute; left: 0; width: 2px; height: 6px; border-radius: 2px; background: var(--line); transition: height 280ms cubic-bezier(.2,.75,.25,1), background-color 280ms ease; }
  a[aria-current]::before { background: var(--muted); }
  a span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: 0; transform: translateY(4px); transition: opacity 280ms ease, transform 280ms ease; }
  .side-toc:is(:hover, :focus-visible, :has(:focus-visible)) a { height: 33px; }
  .side-toc:is(:hover, :focus-visible, :has(:focus-visible)) a::before { height: 20px; }
  .side-toc:is(:hover, :focus-visible, :has(:focus-visible)) a span { opacity: 1; transform: translateY(0); }
  .side-toc:is(:hover, :focus-visible, :has(:focus-visible)) a[aria-current] { color: var(--toc-active); }
  .side-toc:is(:hover, :focus-visible, :has(:focus-visible)) a[aria-current]::before { background: var(--toc-active); }
  a:hover, a:focus-visible { color: var(--ink); }
  @media (max-width: 1280px) {
    .side-toc { left: calc(50% + 388px); width: calc(50% - 412px); }
  }
  @media (max-width: 1100px) { .side-toc { display: none; } }
  @media (prefers-reduced-motion: reduce) { a, a::before, a span { transition: none; } }
</style>
<script>
  const directory = document.querySelector<HTMLElement>('.side-toc');
  if (directory) {
    const links = Array.from(directory.querySelectorAll<HTMLAnchorElement>('a'));
    const headings = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1)))!);
    let pending = false;
    function updateSection() {
      const threshold = document.querySelector('.site-header')!.getBoundingClientRect().bottom + 40;
      let active = 0;
      headings.forEach((heading, index) => { if (heading.getBoundingClientRect().top <= threshold) active = index; });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      pending = false;
    }
    window.addEventListener('scroll', () => {
      if (!pending) { pending = true; requestAnimationFrame(updateSection); }
    }, { passive: true });
    window.addEventListener('resize', updateSection);
    window.addEventListener('load', updateSection);
    document.fonts.ready.then(updateSection);
    updateSection();
  }
</script>
